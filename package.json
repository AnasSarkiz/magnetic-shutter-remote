{
	"name": "@tsci/AnasSarkiz.magnetic-shutter-remote-r8",
	"version": "0.3.29",
	"description": "Routed ESP32-C3 shutter remote engineering prototype; hardware untested",
	"main": "index.circuit.tsx",
	"keywords": [
		"tscircuit",
		"circuit",
		"pcb",
		"electronics"
	],
	"scripts": {
		"dev": "tsci dev",
		"build": "bun run build:pcb && bun run build:enclosure",
		"build:pcb": "python3 cloud/run-heavy.py -- tsci build index.circuit.tsx --pcb-png --pcb-svgs --schematic-svgs --3d-png",
		"build:enclosure": "python3 cloud/run-heavy.py -- tsci build enclosure.circuit.tsx --glbs && python3 cloud/run-heavy.py -- bun scripts/render-product.ts enclosure",
		"snapshot": "tsci snapshot index.circuit.tsx",
		"snapshot:update": "tsci snapshot index.circuit.tsx --update",
		"start": "tsci dev",
		"typecheck": "tsc --noEmit",
		"test": "python3 -m unittest discover -s tests -v",
		"format": "biome format --write index.circuit.tsx enclosure.circuit.tsx product.assembly.tsx product.exploded.tsx product.geometry.tsx src product/assembly.tsx product/viewer.tsx product/geometry.ts product/dimensions.ts scripts package.json tsconfig.json tscircuit.config.json tests/r8-product.test.ts",
		"format:check": "biome format index.circuit.tsx enclosure.circuit.tsx product.assembly.tsx product.exploded.tsx product.geometry.tsx src product/assembly.tsx product/viewer.tsx product/geometry.ts product/dimensions.ts scripts package.json tsconfig.json tscircuit.config.json tests/r8-product.test.ts",
		"render:sheets": "bun scripts/render-sheets.ts",
		"audit:module": "python3 scripts/audit-r8-module.py",
		"product:build": "python3 cloud/run-heavy.py -- tsci build product.assembly.tsx --glbs",
		"product:exploded": "python3 cloud/run-heavy.py -- tsci build product.exploded.tsx --glbs",
		"product:geometry": "python3 cloud/run-heavy.py -- bun scripts/check-product-geometry.ts",
		"product:pcb": "python3 cloud/run-heavy.py -- bun scripts/export-product-pcb.ts",
		"product:prints": "python3 cloud/run-heavy.py -- tooling/gerber-review-venv/bin/python scripts/export-product-prints.py",
		"dev:product": "tsci dev enclosure.circuit.tsx",
		"dev:enclosure": "tsci dev enclosure.circuit.tsx",
		"product:viewer": "python3 cloud/run-heavy.py -- bun scripts/export-product-viewer.ts",
		"dev:exploded": "tsci dev product.exploded.tsx",
		"product:canonical": "python3 cloud/run-heavy.py -- tsci build product.geometry.tsx --glbs",
		"product:models": "python3 cloud/run-heavy.py -- tooling/gerber-review-venv/bin/python scripts/export-product-mechanics.py --source-view product.geometry"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.4",
		"@resvg/resvg-js": "2.6.2",
		"@tscircuit/3d-viewer": "0.0.631",
		"@tscircuit/circuit-json-util": "0.0.128",
		"@tscircuit/cli": "0.1.2402",
		"@tscircuit/core": "0.0.2199",
		"@tscircuit/eval": "0.0.1657",
		"@tscircuit/modelprinter": "0.0.18",
		"@tscircuit/pcb-viewer": "1.11.433",
		"@tscircuit/props": "0.0.709",
		"@tscircuit/schematic-viewer": "2.0.105",
		"@types/bun": "1.3.9",
		"@types/react-dom": "19.3.0",
		"archiver": "7.0.1",
		"bun-match-svg": "0.0.13",
		"circuit-json": "0.0.534",
		"circuit-json-to-bom-csv": "0.0.19",
		"circuit-json-to-gerber": "0.0.114",
		"circuit-json-to-pnp-csv": "0.0.20",
		"circuit-to-svg": "0.0.453",
		"commander": "12.1.0",
		"easyeda": "0.0.381",
		"tscircuit": "0.0.3008",
		"tsup": "8.5.0",
		"typescript": "5.9.3",
		"zod": "3.25.76"
	},
	"author": "AnasSarkiz",
	"private": true,
	"overrides": {
		"@tscircuit/core": "0.0.2199",
		"circuit-json": "0.0.534",
		"@tscircuit/circuit-json-util": "0.0.128",
		"@tscircuit/capacity-autorouter": "0.0.1003",
		"@tscircuit/props": "0.0.709",
		"circuit-to-svg": "0.0.453",
		"circuit-json-to-gerber": "0.0.114",
		"easyeda": "0.0.381",
		"@tscircuit/eval": "0.0.1657",
		"circuit-json-to-pnp-csv": "0.0.20",
		"@tscircuit/cli": "0.1.2402"
	}
}
