+++ b/tests/repros/r7/pt4115-overlapping-ground-pads.test.tsx
@@ -0,0 +1,38 @@
+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+import { PT4115 } from "../../../../../imports/PT4115"
+
+test("C347356 overlapping rectangular and pill ground pads share one PCB port", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={16} height={14} routingDisabled>
+      <net name="GND" isGroundNet />
+      <PT4115
+        name="U1"
+        connections={{ pin2: "net.GND" }}
+        noConnect={["pin1", "pin3", "pin4", "pin5"]}
+      />
+      <pcbnotetext
+        pcbY={-5}
+        text="C347356: overlapping GND copper = one terminal"
+        fontSize={0.65}
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const pads = circuit.db.pcb_smtpad.list()
+  const groundPads = pads.filter((pad) => pad.port_hints?.includes("pin2"))
+  expect(pads).toHaveLength(6)
+  expect(groundPads).toHaveLength(2)
+  expect(groundPads[0].pcb_port_id).toBeTruthy()
+  expect(groundPads[1].pcb_port_id).toBe(groundPads[0].pcb_port_id)
+  expect(circuit.db.pcb_port.list()).toHaveLength(5)
+  expect(circuit.db.source_ambiguous_port_reference.list()).toHaveLength(0)
+  expect(
+    circuit
+      .getCircuitJson()
+      .filter((element) => element.type.endsWith("_error")),
+  ).toHaveLength(0)
+  expect(circuit.db.pcb_solder_paste.list()).toHaveLength(5)
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
