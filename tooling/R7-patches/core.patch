+++ b/tests/repros/r7/mixed-pad-bounds-convention.test.tsx
@@ -0,0 +1,77 @@
+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("SMT pad bounds use maximum Y for top in board space at every rotation and layer", async () => {
+  const { circuit } = getTestFixture()
+  const shapes = ["rect", "circle", "pill"] as const
+  circuit.add(
+    <board width={70} height={40} routingDisabled>
+      {(["top", "bottom"] as const).flatMap((layer, layerIndex) =>
+        [0, 45, 90, 180, 270].flatMap((pcbRotation, rotationIndex) =>
+          shapes.map((shape, shapeIndex) => (
+            <chip
+              key={`U${layerIndex * 15 + rotationIndex * 3 + shapeIndex + 1}`}
+              name={`U${layerIndex * 15 + rotationIndex * 3 + shapeIndex + 1}`}
+              layer={layer}
+              pcbRotation={pcbRotation}
+              pcbX={-27 + rotationIndex * 13}
+              pcbY={-13 + layerIndex * 18 + shapeIndex * 5}
+              footprint={
+                <footprint>
+                  {shape === "circle" ? (
+                    <smtpad
+                      shape="circle"
+                      radius={0.6}
+                      pcbX={0.35}
+                      pcbY={0.4}
+                      portHints={["pin1"]}
+                    />
+                  ) : (
+                    <smtpad
+                      shape={shape}
+                      width={2}
+                      height={1}
+                      radius={0.5}
+                      pcbX={0.35}
+                      pcbY={0.4}
+                      portHints={["pin1"]}
+                    />
+                  )}
+                </footprint>
+              }
+            />
+          )),
+        ),
+      )}
+      <pcbnotetext
+        pcbY={18}
+        text="All shapes: +Y top; translated, rotated, TOP/BOTTOM"
+        fontSize={0.7}
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const pads = circuit.selectAll("smtpad")
+  expect(pads).toHaveLength(30)
+  const emittedShapes = new Set(
+    circuit.db.pcb_smtpad.list().map((pad) => pad.shape),
+  )
+  for (const shape of [
+    "rect",
+    "rotated_rect",
+    "circle",
+    "pill",
+    "rotated_pill",
+  ] as const)
+    expect(emittedShapes.has(shape)).toBe(true)
+  for (const pad of pads) {
+    const { center, bounds, width, height } = pad._getPcbCircuitJsonBounds()
+    expect(bounds.top).toBeGreaterThan(bounds.bottom)
+    expect(bounds.right).toBeGreaterThan(bounds.left)
+    expect(bounds.top - bounds.bottom).toBeCloseTo(height, 10)
+    expect(bounds.right - bounds.left).toBeCloseTo(width, 10)
+    expect(bounds.top).toBeCloseTo(center.y + height / 2, 10)
+    expect(bounds.bottom).toBeCloseTo(center.y - height / 2, 10)
+  }
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
--- a/tests/repros/r7/separated-mixed-ground-pads.test.tsx
+++ b/tests/repros/r7/separated-mixed-ground-pads.test.tsx
@@ -0,0 +1,49 @@
+import { expect, test } from "bun:test"
+import { getTestFixture } from "tests/fixtures/get-test-fixture"
+
+test("Separated mixed-shape pads retain two internally connected ports rather than being merged", async () => {
+  const { circuit } = getTestFixture()
+  circuit.add(
+    <board width={12} height={8} routingDisabled>
+      <chip
+        name="U1"
+        pinLabels={{ pin1: ["GND"] }}
+        noConnect={["pin1"]}
+        footprint={
+          <footprint>
+            <smtpad
+              shape="rect"
+              width={1}
+              height={1}
+              pcbX={-2}
+              portHints={["pin1"]}
+            />
+            <smtpad
+              shape="pill"
+              width={1}
+              height={1}
+              radius={0.5}
+              pcbX={2}
+              portHints={["pin1"]}
+            />
+          </footprint>
+        }
+      />
+      <pcbnotetext
+        pcbY={-2}
+        text="Separated copper: two ports, not one merged port"
+        fontSize={0.65}
+      />
+    </board>,
+  )
+  await circuit.renderUntilSettled()
+  const pads = circuit.db.pcb_smtpad.list()
+  expect(circuit.db.source_ambiguous_port_reference.list()).toHaveLength(0)
+  expect(pads).toHaveLength(2)
+  expect(pads[0].pcb_port_id).toBeTruthy()
+  expect(pads[1].pcb_port_id).toBeTruthy()
+  expect(pads[0].pcb_port_id).not.toBe(pads[1].pcb_port_id)
+  expect(circuit.db.pcb_port.list()).toHaveLength(2)
+  expect(circuit.db.source_component_internal_connection.list()).toHaveLength(1)
+  expect(circuit).toMatchPcbSnapshot(import.meta.path)
+})
