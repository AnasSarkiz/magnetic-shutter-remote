+++ b/tests/circular-paste-path.test.ts
@@ -0,0 +1,133 @@
+import { expect, test } from "bun:test"
+import { closedPastePathToPoints } from "../lib/utils/closed-paste-path-to-points"
+import { EasyEdaJsonSchema } from "../lib/schemas/easy-eda-json-schema"
+import { convertEasyEdaJsonToCircuitJson } from "../lib/convert-easyeda-json-to-tscircuit-soup-json"
+import { generateFootprintTsx } from "../lib/websafe/generate-footprint-tsx"
+import rawPart from "../../../evidence/R7-components/C347356.raweasy.json"
+
+test("straight paste preserves every source vertex exactly", () => {
+  expect(
+    closedPastePathToPoints({
+      pathData: "M 0 0 L 2 0 L 2 1 L 0 1 Z",
+      maximumChordError: 0.0001,
+    }),
+  ).toEqual([
+    { x: 0, y: 0 },
+    { x: 2, y: 0 },
+    { x: 2, y: 1 },
+    { x: 0, y: 1 },
+  ])
+  expect(
+    closedPastePathToPoints({
+      pathData: "m 1e0 0 h 2 v 1 h -2 z",
+      maximumChordError: 0.0001,
+    }),
+  ).toEqual([
+    { x: 1, y: 0 },
+    { x: 3, y: 0 },
+    { x: 3, y: 1 },
+    { x: 1, y: 1 },
+  ])
+})
+
+test("circular arcs preserve flags and bound chord error independently", () => {
+  for (const sweepFlag of [0, 1]) {
+    for (const largeArcFlag of [0, 1]) {
+      const points = closedPastePathToPoints({
+        pathData: `M 1 0 A 1 1 0 ${largeArcFlag} ${sweepFlag} 0 1 L 0 0 Z`,
+        maximumChordError: 0.0001,
+      })
+      const center =
+        largeArcFlag === sweepFlag ? { x: 1, y: 1 } : { x: 0, y: 0 }
+      expect(points[0]).toEqual({ x: 1, y: 0 })
+      expect(points.at(-2)).toEqual({ x: 0, y: 1 })
+      let arcLength = 0
+      for (let index = 1; index < points.length - 1; index++) {
+        const start = points[index - 1],
+          end = points[index]
+        expect(Math.hypot(end.x - center.x, end.y - center.y)).toBeCloseTo(
+          1,
+          10,
+        )
+        const midpoint = { x: (start.x + end.x) / 2, y: (start.y + end.y) / 2 }
+        expect(
+          1 - Math.hypot(midpoint.x - center.x, midpoint.y - center.y),
+        ).toBeLessThanOrEqual(0.0001 + 1e-12)
+        const cross =
+          (start.x - center.x) * (end.y - center.y) -
+          (start.y - center.y) * (end.x - center.x)
+        expect(sweepFlag === 1 ? cross : -cross).toBeGreaterThan(0)
+        arcLength += Math.hypot(end.x - start.x, end.y - start.y)
+      }
+      expect(arcLength).toBeCloseTo(
+        largeArcFlag ? (3 * Math.PI) / 2 : Math.PI / 2,
+        3,
+      )
+    }
+  }
+})
+
+test("relative arcs and radius correction follow SVG endpoint semantics", () => {
+  const points = closedPastePathToPoints({
+    pathData: "M 1 0 a 0.1 0.1 0 0 1 -2 0 L 0 0 Z",
+    maximumChordError: 0.0001,
+  })
+  expect(points.at(-2)).toEqual({ x: -1, y: 0 })
+  for (const point of points.slice(0, -1))
+    expect(Math.hypot(point.x, point.y)).toBeCloseTo(1, 10)
+})
+
+test("unclosed, multi-contour and unsupported paths remain explicit failures", () => {
+  for (const pathData of [
+    "M 0 0 L 1 0 L 0 1",
+    "M 0 0 L 1 0 L 0 1 Z M 2 2 L 3 2 L 2 3 Z",
+    "M 0 0 A 1 2 0 0 1 1 1 L 0 1 Z",
+    "M 0 0 C 0 1 1 0 1 1 Z",
+    "M 0 0 L 1 Z",
+    "M 0 0 L 1 0 L 0 1 @ Z",
+    "M 0 0 A 1 1 0 2 0 1 1 L 0 1 Z",
+  ]) {
+    expect(() =>
+      closedPastePathToPoints({ pathData, maximumChordError: 0.0001 }),
+    ).toThrow()
+  }
+  expect(() =>
+    closedPastePathToPoints({
+      pathData: "M 0 0 L 1 0 L 0 1 Z",
+      maximumChordError: 0,
+    }),
+  ).toThrow()
+})
+
+test("C347356 retains all five supplier paste contours through supported TSX generation", () => {
+  const circuitJson = convertEasyEdaJsonToCircuitJson(
+    EasyEdaJsonSchema.parse(rawPart),
+    { shouldRecenter: false, showDesignator: false },
+  )
+  const paste = circuitJson.filter(
+    (element) => element.type === "pcb_solder_paste",
+  )
+  expect(paste).toHaveLength(5)
+  for (const aperture of paste) {
+    expect(aperture.shape).toBe("polygon")
+    if (aperture.shape !== "polygon")
+      throw new Error("Expected supplier polygon")
+    expect(aperture.points.length).toBeGreaterThanOrEqual(4)
+  }
+  const curved = paste.find(
+    (aperture) => aperture.shape === "polygon" && aperture.points.length > 4,
+  )
+  expect(curved).toBeDefined()
+  const tsx = generateFootprintTsx(circuitJson)
+  expect(tsx.match(/<solderpaste /g)).toHaveLength(5)
+  expect(tsx).toContain('shape="polygon"')
+})
+
+test("unrepresentable chord tolerances fail explicitly rather than looping forever", () => {
+  expect(() =>
+    closedPastePathToPoints({
+      pathData: "M 1 0 A 1 1 0 0 1 0 1 L 0 0 Z",
+      maximumChordError: 1e-30,
+    }),
+  ).toThrow("below numeric resolution")
+})
