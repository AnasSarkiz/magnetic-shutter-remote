@@ -0,0 +1,129 @@
+import type { Point } from "../math/arc-utils"
+
+/** Convert a single closed SVG M/L/H/V/circular-A contour to bounded chords.
+ * Coordinates and chord tolerance use the same units. Unsupported commands
+ * remain errors: they must never be discarded or replaced with a straight line.
+ */
+export function closedPastePathToPoints({
+  pathData,
+  maximumChordError,
+}: {
+  pathData: string
+  maximumChordError: number
+}): Point[] {
+  if (!(maximumChordError > 0) || !Number.isFinite(maximumChordError))
+    throw new Error("Paste chord error must be finite and positive")
+  const tokens =
+    pathData.match(/[a-zA-Z]|[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?/g) ?? []
+  const residue = pathData.replace(
+    /[a-zA-Z]|[-+]?(?:\d*\.\d+|\d+\.?)(?:[eE][-+]?\d+)?|[\s,]/g,
+    "",
+  )
+  if (residue) throw new Error("Invalid paste path token")
+  let tokenIndex = 0
+  let command = ""
+  let cursor: Point = { x: 0, y: 0 }
+  let closed = false
+  const points: Point[] = []
+  const readNumber = () => {
+    const token = tokens[tokenIndex++]
+    if (token === undefined || /^[a-zA-Z]$/.test(token))
+      throw new Error("Incomplete paste path command")
+    const coordinate = Number(token)
+    if (!Number.isFinite(coordinate))
+      throw new Error("Non-finite paste coordinate")
+    return coordinate
+  }
+  while (tokenIndex < tokens.length) {
+    if (/^[a-zA-Z]$/.test(tokens[tokenIndex])) command = tokens[tokenIndex++]
+    if (closed) throw new Error("Multiple paste contours are unsupported")
+    const absoluteCommand = command.toUpperCase()
+    const relative = command !== absoluteCommand
+    if (absoluteCommand === "Z") {
+      if (points.length < 3)
+        throw new Error("Paste contour has fewer than three points")
+      closed = true
+      continue
+    }
+    if (!points.length && absoluteCommand !== "M")
+      throw new Error("Paste contour must begin with M")
+    if (absoluteCommand === "M" || absoluteCommand === "L") {
+      if (absoluteCommand === "M" && points.length)
+        throw new Error("Multiple paste contours are unsupported")
+      const x = readNumber() + (relative ? cursor.x : 0)
+      const y = readNumber() + (relative ? cursor.y : 0)
+      cursor = { x, y }
+      points.push(cursor)
+      if (absoluteCommand === "M") command = relative ? "l" : "L"
+    } else if (absoluteCommand === "H" || absoluteCommand === "V") {
+      const coordinate = readNumber()
+      cursor =
+        absoluteCommand === "H"
+          ? { x: coordinate + (relative ? cursor.x : 0), y: cursor.y }
+          : { x: cursor.x, y: coordinate + (relative ? cursor.y : 0) }
+      points.push(cursor)
+    } else if (absoluteCommand === "A") {
+      const radiusX = Math.abs(readNumber())
+      const radiusY = Math.abs(readNumber())
+      readNumber() // Rotation cannot change a circle.
+      const largeArcFlag = readNumber()
+      const sweepFlag = readNumber()
+      if (![0, 1].includes(largeArcFlag) || ![0, 1].includes(sweepFlag))
+        throw new Error("Invalid paste arc flags")
+      if (radiusX !== radiusY || radiusX === 0)
+        throw new Error("Non-circular paste arcs are unsupported")
+      const end = {
+        x: readNumber() + (relative ? cursor.x : 0),
+        y: readNumber() + (relative ? cursor.y : 0),
+      }
+      const halfX = (cursor.x - end.x) / 2
+      const halfY = (cursor.y - end.y) / 2
+      const halfChordSquared = halfX ** 2 + halfY ** 2
+      if (halfChordSquared > 0) {
+        // SVG endpoint-to-center conversion; SVG requires radius correction
+        // when the specified radius cannot span the endpoint chord.
+        const radius = Math.max(radiusX, Math.sqrt(halfChordSquared))
+        const sign = largeArcFlag === sweepFlag ? -1 : 1
+        const factor =
+          sign * Math.sqrt(Math.max(0, radius ** 2 / halfChordSquared - 1))
+        const center = {
+          x: (cursor.x + end.x) / 2 + factor * halfY,
+          y: (cursor.y + end.y) / 2 - factor * halfX,
+        }
+        const startAngle = Math.atan2(cursor.y - center.y, cursor.x - center.x)
+        let sweepAngle =
+          Math.atan2(end.y - center.y, end.x - center.x) - startAngle
+        if (sweepFlag === 1 && sweepAngle < 0) sweepAngle += 2 * Math.PI
+        if (sweepFlag === 0 && sweepAngle > 0) sweepAngle -= 2 * Math.PI
+        // Sagitta r*(1-cos(theta/2)) bounds every chord's contour error.
+        const maximumAngle =
+          2 * Math.acos(1 - Math.min(maximumChordError / radius, 1))
+        if (!(maximumAngle > 0) || !Number.isFinite(maximumAngle))
+          throw new Error("Paste chord tolerance is below numeric resolution")
+        const segmentCount = Math.max(
+          1,
+          Math.ceil(Math.abs(sweepAngle) / maximumAngle),
+        )
+        if (!Number.isSafeInteger(segmentCount))
+          throw new Error("Paste arc requires an unsafe number of segments")
+        for (
+          let segmentIndex = 1;
+          segmentIndex < segmentCount;
+          segmentIndex++
+        ) {
+          const angle = startAngle + (sweepAngle * segmentIndex) / segmentCount
+          points.push({
+            x: center.x + radius * Math.cos(angle),
+            y: center.y + radius * Math.sin(angle),
+          })
+        }
+        points.push(end)
+      }
+      cursor = end
+    } else {
+      throw new Error(`Unsupported paste path command ${command}`)
+    }
+  }
+  if (!closed) throw new Error("Paste contour must be closed with Z")
+  return points
+}
